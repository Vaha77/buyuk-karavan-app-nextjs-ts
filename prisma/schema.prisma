generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SELLER
  VIEWER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

model User {
  id             String               @id @default(cuid())
  name           String
  phone          String               @unique
  password       String
  role           Role                 @default(VIEWER)
  status         UserStatus           @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  kalkulyatorlar KalkulyatorSession[]
  salesLimit     Float?
  tolovlar       Tolov[]
  hisoblar       Hisob[]
}

model Kategoriya {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  icon        String?
  parentId    String?
  parent      Kategoriya?  @relation("KategoriyaChild", fields: [parentId], references: [id])
  children    Kategoriya[] @relation("KategoriyaChild")
  createdAt   DateTime     @default(now())
  mahsulotlar Mahsulot[]
}

model Mahsulot {
  id                 String               @id @default(cuid())
  name               String
  model              String?
  brend              String?
  birlik             String               @default("dona")
  priceUsd           Float
  image              String?
  description        String?
  isActive           Boolean              @default(true)
  categoryId         String
  category           Kategoriya           @relation(fields: [categoryId], references: [id])
  createdAt          DateTime             @default(now())
  kgPerMetr          Float?               @default(0)
  updatedAt          DateTime             @updatedAt
  komplektItemlar    KomplektItem[]
  kalkulyatorItemlar KalkulyatorItem[]
}

model Komplekt {
  id          String         @id @default(cuid())
  name        String
  modelCode   String
  image       String?
  description String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  itemlar     KomplektItem[]
}

model KomplektItem {
  id         String   @id @default(cuid())
  komplektId String
  komplekt   Komplekt @relation(fields: [komplektId], references: [id])
  mahsulotId String
  mahsulot   Mahsulot @relation(fields: [mahsulotId], references: [id])
  miqdor     Int      @default(1)
}

model KalkulyatorSession {
  id         String            @id @default(cuid())
  mijozIsm   String
  mijozTel   String
  sotuvchiId String
  sotuvchi   User              @relation(fields: [sotuvchiId], references: [id])
  jami       Float
  yuborildi  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  itemlar    KalkulyatorItem[]
}

model KalkulyatorItem {
  id         String             @id @default(cuid())
  sessionId  String
  session    KalkulyatorSession @relation(fields: [sessionId], references: [id])
  mahsulotId String
  mahsulot   Mahsulot           @relation(fields: [mahsulotId], references: [id])
  miqdor     Int                @default(1)
  narxUsd    Float
}

model Product {
  id        String   @id @default(cuid())
  name      String
  category  String
  tur       String   @default("oddiy")
  birlik    String   @default("dona")
  kgPerMetr Float?   @default(0)
  image     String
  images    Json
  priceUsd  Float
  priceUzs  Float
  shortDesc String
  fullDesc  String
  rating    Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Filial {
  id        String   @id @default(cuid())
  name      String
  manzil    String?
  limit     Float    @default(500000)
  createdAt DateTime @default(now())
  tolovlar  Tolov[]
}

model Tolov {
  id         String   @id @default(cuid())
  sana       DateTime @default(now())
  filialId   String
  filial     Filial   @relation(fields: [filialId], references: [id])
  sotuvchiId String
  sotuvchi   User     @relation(fields: [sotuvchiId], references: [id])
  mijoz      String
  summa      Float
  tolovTuri  String   @default("Naqd")
  izoh       String?
  createdAt  DateTime @default(now())
}

model Hisob {
  id         String      @id @default(cuid())
  mijozIsm   String
  mijozTel   String
  brend      String
  model      String
  foiz       Float       @default(0)
  tanNarxi   Float       @default(0)
  jamiNarx   Float       @default(0)
  sotuvchiId String
  sotuvchi   User        @relation(fields: [sotuvchiId], references: [id])
  qismlar    HisobQism[]
  createdAt  DateTime    @default(now())
}

model HisobQism {
  id       String @id @default(cuid())
  hisobId  String
  hisob    Hisob  @relation(fields: [hisobId], references: [id])
  nom      String
  mahsulot String
  miqdor   Int    @default(1)
  narx     Float
}